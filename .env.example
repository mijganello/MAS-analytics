# LLM провайдер: "deepseek" или "ollama"
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-key-here

# Безопасность
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# БД и кэш (автоматически настроены в docker-compose)
DATABASE_URL=postgresql+asyncpg://mas:mas@postgres:5432/mas_analytics
REDIS_URL=redis://redis:6379/0

# Ollama (если LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://ollama:11434

# Лимиты
MAX_UPLOAD_SIZE_MB=50
SESSION_TTL_HOURS=24
MAX_TASK_RETRIES=2
MAX_TASK_TOKENS=8000
TASK_TIMEOUT_SECONDS=120

# Окружение
ENVIRONMENT=development
