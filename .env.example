# LLM провайдер: "deepseek" или "ollama"
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-key-here

# Безопасность
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# БД и кэш (автоматически настроены в docker-compose)
DATABASE_URL=postgresql+asyncpg://mas:mas@postgres:5432/mas_analytics
REDIS_URL=redis://redis:6379/0

# Ollama — всегда запускается в docker-compose, переключатель в UI работает per-session
# Модели скачиваются автоматически при первом старте (см. ollama-init в docker-compose)
OLLAMA_BASE_URL=http://ollama:11434
# Для машин с >12 GB VRAM можно поставить более мощные модели:
# OLLAMA_WORKER_MODEL=qwen2.5:14b
# OLLAMA_ORCHESTRATOR_MODEL=qwen2.5:14b

# Лимиты
MAX_UPLOAD_SIZE_MB=50
SESSION_TTL_HOURS=24
MAX_TASK_RETRIES=2
MAX_TASK_TOKENS=8000
TASK_TIMEOUT_SECONDS=120

# Окружение
ENVIRONMENT=development
